# LocalShield AI - Environment Configuration Example
# Copy this file to .env and customize for your environment.
# NEVER commit your actual .env file or real API keys to version control!

# AI Provider Settings
# Options: 'mock', 'openai', 'ollama'
AI_PROVIDER=mock

# Model Name
AI_MODEL=mock-llama-3

# API Key for External Providers (Not needed for 'mock')
# Placeholders only. Do NOT put real secrets here.
AI_API_KEY=your_api_key_placeholder_here

# Base URL for API Providers (e.g. https://api.openai.com/v1 or http://localhost:11434/v1 for Ollama)
AI_API_URL=https://api.openai.com/v1

# Network Request Timeout in Seconds
AI_TIMEOUT_SECONDS=30.0

# Maximum Allowed AI Response Size (characters)
MAX_AI_RESPONSE_LENGTH=100000

# Gateway Settings
MAX_PROMPT_LENGTH=50000
SESSION_TTL_SECONDS=900

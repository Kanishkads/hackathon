# ==============================================================================
# LocalShield AI - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in the backend directory:
#      cp backend/.env.example backend/.env   (or Copy-Item in PowerShell)
# 2. Configure your desired AI provider and model credentials below.
# 3. NEVER commit your actual .env file or real API keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active AI Provider
# ------------------------------------------------------------------------------
# Options:
#   - 'gemma'     : Real Google DeepMind Gemma 4 model (Google AI Studio or OpenRouter)
#   - 'google'    : Google AI Studio native REST endpoint
#   - 'openrouter': OpenRouter unified gateway (google/gemma-4-26b-a4b-it, etc.)
#   - 'ollama'    : Local Ollama runtime (http://localhost:11434/v1)
#   - 'openai'    : Standard OpenAI-compatible completions endpoint
#   - 'mock'      : Offline local simulation (zero network calls, default for tests)
AI_PROVIDER=gemma

# ------------------------------------------------------------------------------
# 2. Gemma 4 Model Selection
# ------------------------------------------------------------------------------
# Google DeepMind Gemma 4 open-weights model family (Apache 2.0 License).
# Verified supported model identifiers:
#   - Google AI Studio : gemma-4-26b-a4b-it (Recommended), gemma-4-31b-it
#   - OpenRouter       : google/gemma-4-26b-a4b-it, google/gemma-4-31b-it
#   - Local Ollama     : gemma4, gemma-4-e2b-it, gemma-4-e4b-it, gemma-4-12b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# ------------------------------------------------------------------------------
# 3. Provider Credentials & Endpoint URLs
# ------------------------------------------------------------------------------
# Google AI Studio API Key (obtain from https://aistudio.google.com/app/apikey)
# Leave blank ONLY if using 'mock' or local Ollama (http://localhost:11434/v1).
GEMMA_API_KEY=your_google_ai_studio_api_key_here

# Base API Endpoint URL:
#   - Google AI Studio : https://generativelanguage.googleapis.com/v1beta
#   - OpenRouter       : https://openrouter.ai/api/v1
#   - Local Ollama     : http://localhost:11434/v1
GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta

# ------------------------------------------------------------------------------
# 4. Fallback / Universal Provider Variables (Optional)
# ------------------------------------------------------------------------------
# If GEMMA_* variables are omitted, the gateway falls back to these variables:
AI_MODEL=gemma-4-26b-a4b-it
AI_API_KEY=your_api_key_placeholder_here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta

# ------------------------------------------------------------------------------
# 5. Security Constraints & Timeouts
# ------------------------------------------------------------------------------
# Network Request Timeout in Seconds
AI_TIMEOUT_SECONDS=30.0

# Maximum Allowed AI Response Size (characters)
MAX_AI_RESPONSE_LENGTH=100000

# Maximum User Prompt Length (characters)
MAX_PROMPT_LENGTH=50000

# Ephemeral Session Lifetime (seconds; 900 = 15 minutes)
SESSION_TTL_SECONDS=900
